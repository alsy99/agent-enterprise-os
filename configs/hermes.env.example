# Hermes / generic OpenAI-compatible env snippet
# Export before launching Hermes Agent.

# Via LiteLLM (recommended — roles as model names)
export OPENAI_BASE_URL="http://127.0.0.1:4000/v1"
export OPENAI_API_KEY="${LITELLM_MASTER_KEY:-sk-company-os-local}"
export HERMES_MODEL_PLANNER="planner"
export HERMES_MODEL_WORKER="worker"
export HERMES_MODEL_VERIFIER="verifier"
export HERMES_MODEL_CODER="coder"

# Direct Google (planner/worker without proxy)
# export OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
# export OPENAI_API_KEY="$GOOGLE_API_KEY"
# export HERMES_MODEL_PLANNER="gemini-3.6-flash"
# export HERMES_MODEL_WORKER="gemini-3.5-flash-lite"
