# Direct provider env (no LiteLLM). Copy/export after .env is filled.
# Usage from repo root:
#   set -a && source .env && source configs/hermes.env.direct.example && set +a
# Then launch Hermes with cwd = this repo root so it loads AGENTS.md + skills/.

export OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
export OPENAI_API_KEY="${GOOGLE_API_KEY}"

# Week-1 roles without proxy (names are provider model ids)
export HERMES_MODEL_PLANNER="gemini-3.6-flash"
export HERMES_MODEL_WORKER="gemini-3.5-flash-lite"
# Verifier: call Groq separately (different family) — do not route via this OPENAI_* pair
export HERMES_MODEL_VERIFIER="openai/gpt-oss-120b"
export GROQ_BASE_URL="https://api.groq.com/openai/v1"
