# Copy to .env and fill keys. Never commit .env.
# Get keys: Google AI Studio, Groq, NVIDIA Build, OpenRouter, Mistral, Z.AI

# --- Required for week-1 prototype ---
GOOGLE_API_KEY=
GROQ_API_KEY=

# --- Add when coding quality is the bottleneck ---
NVIDIA_API_KEY=
MISTRAL_API_KEY=
ZAI_API_KEY=

# --- Failover (top up $10 on OpenRouter for ~1000 RPD) ---
OPENROUTER_API_KEY=

# --- Optional LiteLLM proxy ---
LITELLM_MASTER_KEY=sk-company-os-local
LITELLM_BASE_URL=http://127.0.0.1:4000/v1

# --- Harness roles (point OpenCode / Hermes at these) ---
MODEL_PLANNER=planner
MODEL_WORKER=worker
MODEL_VERIFIER=verifier
MODEL_CODER=coder
MODEL_THINKER=thinker
MODEL_FAILOVER=failover

# If not using LiteLLM, set provider base URLs directly:
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=$GOOGLE_API_KEY
