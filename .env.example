# Copy to .env and fill keys. Never commit .env.
# Get keys: Google AI Studio, Groq, NVIDIA Build, OpenRouter, Mistral, Z.AI

# --- Required for week-1 prototype ---
GOOGLE_API_KEY=
GROQ_API_KEY=

# --- Add when coding quality is the bottleneck ---
NVIDIA_API_KEY=
MISTRAL_API_KEY=
ZAI_API_KEY=

# --- Failover (top up $10 on OpenRouter for ~1000 RPD) ---
OPENROUTER_API_KEY=

# --- Optional LiteLLM proxy (virtual keys: https://docs.litellm.ai/docs/proxy/virtual_keys) ---
# Master key = proxy admin key. MUST start with sk- . Used to mint virtual keys via /key/generate.
LITELLM_MASTER_KEY=sk-change-me
# Postgres required for virtual-key spend/auth tables (Supabase, Neon, local, etc.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
LITELLM_BASE_URL=http://127.0.0.1:4000/v1

# --- Harness roles (point OpenCode / Hermes at these) ---
MODEL_PLANNER=planner
MODEL_WORKER=worker
MODEL_VERIFIER=verifier
MODEL_CODER=coder
MODEL_THINKER=thinker
MODEL_FAILOVER=failover

# If not using LiteLLM, set provider base URLs directly:
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=$GOOGLE_API_KEY
